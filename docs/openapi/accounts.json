{
  "openapi": "3.0.3",
  "info": {
    "title": "Accounts API",
    "version": "1.0.0",
    "description": "Endpoints para manejar cuentas de usuario"
  },
  "paths": {
    "/accounts/list/": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Listar cuentas",
        "description": "Lista todos los usuarios registrados en la tabla account. Requiere autenticación.",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de cuentas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                },
                "examples": {
                  "Ejemplo": {
                    "value": [
                      {
                        "id_account": 1,
                        "user": "usuario1",
                        "password": "********",
                        "subscription": "basic"
                      },
                      {
                        "id_account": 2,
                        "user": "usuario2",
                        "password": "********",
                        "subscription": "premium"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/create/": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Crear cuenta",
        "description": "Crea un nueva cuenta y la almacena en la tabla Account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Account" },
              "examples": {
                "Ejemplo candidato": {
                  "value": {
                    "user": "correo@electronico",
                    "password": "contraseña",
                    "subscription": "candidate",
                    "status": 1
                  }
                },
                "Ejemplo compañia": {
                  "value": {
                    "user": "correo@electronico",
                    "password": "contraseña",
                    "subscription": "companie",
                    "status": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada correctamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "400": {
            "description": "Error 400: BAD REQUEST",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/accounts/read/": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Leer cuenta(s)",
        "description": "Retorna la informacion de la cuenta que coincide con el `token`.",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Información de la(s) cuenta(s)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Account" },
                    { "type": "array", "items": { "$ref": "#/components/schemas/Account" } }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Cuenta no encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "Ejemplo": { "value": { "code": 0, "message": "Account not found" } }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/update/": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Actualizar cuenta",
        "description": "Actualiza la cuenta que esa asociada al `token`. \n ### Campos que puedes actualizar\n- `status`\n- `password`\n- `subscription`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AccountUpdate" }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cuenta actualizada exitosamente",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Account" } }
            }
          },
          "400": {
            "description": "No se proporcionaron campos válidos o error de validación",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "NoValidFields": {
                    "value": { "code": 0, "message": "No valid fields provided" }
                  },
                  "ValidationError": {
                    "value": { "code": 0, "message": "Error de validación de datos" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cuenta no encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "AccountNotFound": {
                    "value": { "code": 0, "message": "Account not found" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/deactivate/": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Desactivar cuenta",
        "description": "Desactiva la cuenta asociada al `token` del usuario autenticado.\n\nCambia el campo `status` a `0`.",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {}
        },
        "responses": {
          "200": {
            "description": "Cuenta desactivada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  },
                  "example": {
                    "message": "Account deactivated successfully"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cuenta no encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "AccountNotFound": {
                    "value": { "code": 0, "message": "Account not found" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/token_login/": {
      "post": {
        "tags": ["Accounts"],
        "summary": "Login con token JWT",
        "description": "Endpoint de autenticación manual. Recibe usuario y contraseña y devuelve tokens JWT.\nFlujo de respuesta:\n- Valida usuario y contraseña\n- Genera access token (1 hora)\n- Genera refresh token (7 días)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TokenLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acceso permitido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenLoginResponse" },
                "examples": {
                  "Ejemplo": {
                    "value": {
                      "code": 1,
                      "message": "Acceso permitido",
                      "refresh": "xxxxx.yyyyy.zzzzz",
                      "access": "xxxxx.yyyyy.zzzzz",
                      "id_account": 1,
                      "user": "testuser",
                      "subscription": "basic"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Faltan datos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "Ejemplo": {
                    "value": { "code": 0, "message": "Se requiere usuario y contraseña" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Contraseña incorrecta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "Ejemplo": {
                    "value": { "code": 0, "message": "Contraseña incorrecta" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "Ejemplo": {
                    "value": { "code": 0, "message": "Usuario no encontrado" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id_account": { "type": "integer" },
          "status": { "type": "integer" },
          "user": { "type": "string" },
          "password": { "type": "string" },
          "subscription": { "type": "string" }
        },
        "required": ["user", "password", "subscription"]
      },
      "AccountUpdate": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "password": { "type": "string" },
          "subscription": { "type": "string" }
        }
      },
      "TokenLoginRequest": {
        "type": "object",
        "properties": {
          "user": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["user", "password"]
      },
      "TokenLoginResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "refresh": { "type": "string" },
          "access": { "type": "string" },
          "id_account": { "type": "integer" },
          "user": { "type": "string" },
          "subscription": { "type": "string" }
        },
        "required": ["code","message","refresh","access","id_account","user","subscription"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"]
      }
    }
  }
}
