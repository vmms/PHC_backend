{
  "openapi": "3.0.3",
  "info": {
    "title": "Companies API",
    "version": "1.0.0",
    "description": "Endpoints para manejar compañías"
  },
  "tags": [
    {
      "name": "Companies",
      "description": "Operaciones relacionadas con compañías"
    }
  ],
  "paths": {
    "/companies/list/": {
      "get": {
        "tags": ["Companies"],
        "summary": "Listar compañías",
        "description": "Obtiene una lista de todas las compañías registradas.",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de compañías obtenida correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Company" }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": { "type": "string" },
                        "results": {
                          "type": "array",
                          "items": { "type": "object" }
                        }
                      },
                      "example": {
                        "message": "No companies found",
                        "results": []
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" },
                    "details": { "type": "string" }
                  }
                },
                "example": {
                  "error": "Unexpected server error",
                  "details": "error message here"
                }
              }
            }
          }
        }
      }
    },
    "/companies/get/": {
      "get": {
        "tags": ["Companies"],
        "summary": "Obtener compañía del usuario",
        "description": "Devuelve la compañía asociada al usuario autenticado por el `token`",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {}
        },
        "responses": {
          "200": {
            "description": "Compañía encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "404": {
            "description": "No hay compañía asociada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "No company associated with this user"
                }
              }
            }
          }
        }
      }
    },
    "/companies/create/": {
      "post": {
        "tags": ["Companies"],
        "summary": "Crear compañía",
        "description": "Crea una nueva compañía asociada automáticamente al usuario autenticado.",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Company" },
              "example": {
                "name": "Tech Solutions MX",
                "address": {
                  "street": "Av. Central 123",
                  "state": "CDMX",
                  "zip_code": "01234",
                  "country": "Mexico"
                },
                "primary_contact": "Luis Perez",
                "title_pc": "Director",
                "phone_number_pc": "55-1234-5678",
                "email_pc": "luis@techmx.com",
                "secondary_contact": "Maria Lopez",
                "title_sc": "Asistente",
                "phone_number_sc": "55-8765-4321",
                "email_sc": "maria@techmx.com",
                "description": "Desarrollo de software",
                "link": "https://techmx.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compañía creada correctamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Company" }
              }
            }
          },
          "400": {
            "description": "Error en los datos proporcionados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/companies/update/": {
      "put": {
        "tags": ["Companies"],
        "summary": "Actualizar compañía",
        "description": "Actualiza la compañía asociada al usuario autenticado",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "description": "Token JWT para autenticación",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer <token>"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/Company"},
              "example": {
                "name": "Tech Solutions MX",
                "address": {
                  "street": "Av. Central 123",
                  "state": "CDMX",
                  "zip_code": "01234",
                  "country": "Mexico"
                },
                "primary_contact": "Luis Perez",
                "title_pc": "Director",
                "phone_number_pc": "55-1234-5678",
                "email_pc": "luis@techmx.com",
                "secondary_contact": "Maria Lopez",
                "title_sc": "Asistente",
                "phone_number_sc": "55-8765-4321",
                "email_sc": "maria@techmx.com",
                "description": "Desarrollo de software",
                "link": "https://techmx.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compañía actualizada",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Company"}
              }
            }
          },
          "404": {
            "description": "No hay compañía asociada",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "example": {
                  "message": "No company associated with this user"
                }
              }
            }
          },
          "400": {
            "description": "Error en los datos",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/companies/delete/{pk}/": {
      "delete": {
        "tags": ["Companies"],
        "summary": "Eliminar compañía",
        "description": "Elimina una compañía por su ID",
        "parameters": [
          {
            "name": "pk",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID de la compañía a eliminar"
          }
        ],
        "responses": {
          "200": {
            "description": "Compañía eliminada",
            "content": {
              "application/json": {
                "schema": {"type": "object", "properties": {"message": {"type": "string"}}},
                "example": {"message": "Company deleted successfully"}
              }
            }
          },
          "404": {
            "description": "Compañía no encontrada",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "example": {"message": "Company not found"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Company": {
        "type": "object",
        "properties": {
          "id_company": { "type": "integer" },
          "name": { "type": "string" },
          "account": { "type": "integer" },

          "address": {
            "type": "object",
            "properties": {
              "id_address": { "type": "integer" },
              "street": { "type": "string" },
              "state": { "type": "string" },
              "zip_code": { "type": "string" },
              "country": { "type": "string" }
            },
            "required": ["street", "state", "zip_code", "country"]
          },

          "primary_contact": { "type": "string" },
          "title_pc": { "type": "string" },
          "phone_number_pc": { "type": "string" },
          "email_pc": { "type": "string" },

          "secondary_contact": { "type": "string" },
          "title_sc": { "type": "string" },
          "phone_number_sc": { "type": "string" },
          "email_sc": { "type": "string" },

          "description": { "type": "string" },
          "link": { "type": "string" }
        },

        "required": [
          "name",
          "account",
          "address",
          "primary_contact",
          "title_pc",
          "phone_number_pc",
          "email_pc",
          "secondary_contact",
          "title_sc",
          "phone_number_sc",
          "email_sc",
          "description",
          "link"
        ]
      },
      "CompanyCreateRequest": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "address": {"type": "string"},
          "phone": {"type": "string"}
        },
        "required": ["name", "address", "phone"]
      },
      "CompanyUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "address": {"type": "string"},
          "phone": {"type": "string"}
        },
        "required": ["name", "address", "phone"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {"type": "string"}
        },
        "required": ["message"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
